# --- required ---
DATABASE_URL=postgres://aa:aa@localhost:5432/aa_dev
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-44-char-base64-of-32-random-bytes
SESSION_COOKIE_DOMAIN=localhost
# Commit SHA shown on the super-admin system-health page (optional; set in CI/deploy).
GIT_SHA=

# --- mail (bootstrap; Super-Admin UI manages later) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=no-reply@aa-rentacar.com

# --- payment + maps (bootstrap; Super-Admin UI manages later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_WEBHOOK_SECRET=
# Public base URL for building payment redirect URLs
APP_BASE_URL=http://localhost:3000
# Bank-transfer payout details shown to customers (free text)
BANK_TRANSFER_DETAILS=
MAPBOX_TOKEN=
# Public Mapbox token for the customer live-tracking map (safe to ship to the browser).
# When empty the tracking page degrades to a non-map fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- minio (local dev) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio-dev
MINIO_SECRET_KEY=minio-dev-secret
MINIO_USE_SSL=false

# --- bootstrap superadmin (used by scripts/bootstrap.ts) ---
SUPERADMIN_EMAIL=admin@aa-rentacar.com
SUPERADMIN_PASSWORD=change-me-on-first-login

# --- observability (Plan #13) ---
# Preferred path: paste the GlitchTip DSN into Super-Admin -> Provider
# Credentials. These env vars are the fallback. Empty => Sentry SDK no-op
# (build/dev/CI never require a DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload is opt-in at build time only:
# SENTRY_UPLOAD_SOURCE_MAPS=1 SENTRY_AUTH_TOKEN=... SENTRY_ORG=... SENTRY_PROJECT=... SENTRY_URL=https://glitchtip.aa-rentacar.com

# --- virus scanning (Plan #13) ---
# clamd TCP endpoint used by the scan-uploaded-file worker job. Defaults to the
# compose service name when unset.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- production-only (set in .env.production on the VPS) ---
# POSTGRES_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# GLITCHTIP_DB_PASSWORD=
# GLITCHTIP_SECRET_KEY=

# --- web-push / VAPID ---
# Generate with: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(JSON.stringify(k,null,2))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:manager@aa-rentacar.com
