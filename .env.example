# --- required ---
DATABASE_URL=postgres://aa:aa@localhost:5432/aa_dev
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-44-char-base64-of-32-random-bytes
SESSION_COOKIE_DOMAIN=localhost

# --- mail (bootstrap; Super-Admin UI manages later) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=no-reply@aa-rentacar.com

# --- payment + maps (bootstrap; Super-Admin UI manages later) ---
STRIPE_SECRET_KEY=
TABBY_SECRET_KEY=
MAPBOX_TOKEN=

# --- minio (local dev) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio-dev
MINIO_SECRET_KEY=minio-dev-secret
MINIO_USE_SSL=false

# --- bootstrap superadmin (used by scripts/bootstrap.ts) ---
SUPERADMIN_EMAIL=admin@aa-rentacar.com
SUPERADMIN_PASSWORD=change-me-on-first-login

# --- web-push / VAPID ---
# Generate with: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(JSON.stringify(k,null,2))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:manager@aa-rentacar.com
