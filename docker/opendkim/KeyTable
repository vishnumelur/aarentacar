# OpenDKIM KeyTable (Plan #12).
# Maps a selector record to (domain, selector, private-key-path). The key file
# is generated by scripts/dkim-keygen.sh and mounted read-only at
# /etc/opendkim/keys (see docker-compose production block).
default._domainkey.aa-rentacar.com aa-rentacar.com:default:/etc/opendkim/keys/default.private
